# SERVER ONLY. Never prefix these names with VITE_. All features default off.
DELIVERY_ENABLED=false
DELIVERY_EMAIL_ENABLED=false
DELIVERY_PRIVATE_STORE_CONFIRMED=false
DELIVERY_CLEANUP_CONFIGURED=false
DELIVERY_ORIGIN=https://your-accepted-production-domain.example
DELIVERY_SIGNING_SECRET=
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Preferred for Gmail/automation via n8n (set HTTPS public n8n URL in Vercel production):
N8N_EMAIL_WEBHOOK_URL=
N8N_LOG_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
N8N_EMAIL_TIMEOUT_MS=15000
# Optional alternative if using Resend directly instead of n8n:
RESEND_API_KEY=
RESEND_FROM=
