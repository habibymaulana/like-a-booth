# Local development with local Docker n8n (never commit real secrets).
# Copy to .env.local (already gitignored) and generate random values with: openssl rand -hex 32
DELIVERY_ENABLED=true
DELIVERY_LOCAL_MODE=true
DELIVERY_EMAIL_ENABLED=true
DELIVERY_ORIGIN=http://127.0.0.1:5174
DELIVERY_SIGNING_SECRET=
CRON_SECRET=
N8N_EMAIL_WEBHOOK_URL=http://localhost:5678/webhook/like-a-booth/send-email
N8N_LOG_WEBHOOK_URL=http://localhost:5678/webhook/like-a-booth/activity-log
N8N_WEBHOOK_SECRET=
N8N_EMAIL_TIMEOUT_MS=15000
