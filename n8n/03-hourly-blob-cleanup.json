{
  "name": "Hourly: clean up expired Like a Booth blobs",
  "nodes": [
    {
      "id": "af91f1b4-fb4a-4b79-b0df-eeeb41f9114c",
      "name": "Schedule Every Hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [0, 0],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1,
              "triggerAtMinute": 5
            }
          ]
        }
      }
    },
    {
      "id": "e3363935-3d50-4191-af08-afb6cfbea2e7",
      "name": "Call Vercel Cleanup",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [224, 0],
      "parameters": {
        "method": "GET",
        "url": "https://<domain-vercel-kamu>/api/delivery/cleanup",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpTemplatedCustomAuth",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            { "name": "Accept", "value": "application/json" }
          ]
        },
        "options": {
          "timeout": 25000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "49814a53-cd62-4bda-ab85-ffc69e62ff8a",
      "name": "More Blobs Remaining?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [448, 0],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "more-check",
              "leftValue": "={{ $(\"Call Vercel Cleanup\").item.json.more === true }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "rightValue": false
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "39f6c7f5-1226-4039-9849-f397d6caf6da",
      "name": "Notify Cleanup Backlog",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [672, 0],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "authentication": "oAuth2",
        "sendTo": "technojiwa@gmail.com",
        "subject": "[Like a Booth] Cleanup pagination backlog (more=true)",
        "emailType": "html",
        "message": "=<p>Hourly blob cleanup returned <strong>more: true</strong> (more than 5,000 objects scanned in one run).</p><p><strong>Removed:</strong> {{ $(\"Call Vercel Cleanup\").item.json.removed ?? 0 }}<br/><strong>Examined:</strong> {{ $(\"Call Vercel Cleanup\").item.json.examined ?? 0 }}</p><p>Consider triggering an extra cleanup run or inspecting your Vercel Blob bucket.</p>",
        "options": {
          "appendAttribution": false,
          "senderName": "like a booth alerts"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    }
  ],
  "connections": {
    "Schedule Every Hour": {
      "main": [
        [{ "node": "Call Vercel Cleanup", "type": "main", "index": 0 }]
      ]
    },
    "Call Vercel Cleanup": {
      "main": [
        [{ "node": "More Blobs Remaining?", "type": "main", "index": 0 }]
      ]
    },
    "More Blobs Remaining?": {
      "main": [
        [{ "node": "Notify Cleanup Backlog", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Jakarta"
  },
  "active": false
}
