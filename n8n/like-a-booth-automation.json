            {
              "id": "log-res",
              "name": "result",
              "value": "={{ (() => {\n  const raw = $json.body ?? $json ?? {};\n  const body = typeof raw === \"object\" && raw !== null ? raw : {};\n  const errors = [];\n  const ALLOWED_EVENTS = [\"session_created\", \"email_sent\", \"email_failed\", \"cleanup_completed\"];\n  const REQUIRED_SCHEMA = {\n    type: \"object\",\n    properties: {\n      event: { type: \"string\", enum: ALLOWED_EVENTS, description: \"Lifecycle event name\" },\n      status: { type: \"string\", minLength: 1, description: \"Event outcome status\" },\n      mode: { type: \"string\", description: \"camera or simulation\" },\n      sessionId: { type: \"string\", description: \"Session identifier\" },\n      recipientDomain: { type: \"string\", description: \"Email recipient domain only (no PII)\" },\n      expiresAt: { type: \"string\", description: \"ISO expiration timestamp\" },\n      removed: { type: \"number\", description: \"Removed blob count on cleanup\" },\n      examined: { type: \"number\", description: \"Examined blob count on cleanup\" },\n      timestamp: { type: \"string\", description: \"Event ISO timestamp\" }\n    },\n    required: [\"event\", \"status\"]\n  };\n  if (typeof body.event !== \"string\" || ALLOWED_EVENTS.indexOf(body.event) === -1) {\n    errors.push({ p: \"event\", m: \"Must be one of: \" + ALLOWED_EVENTS.join(\", \"), d: \"Lifecycle event name\" });\n  }\n  if (typeof body.status !== \"string\" || body.status.trim().length < 1) {\n    errors.push({ p: \"status\", m: \"Expected non-empty status string\", d: \"Event outcome status\" });\n  }\n  if (errors.length === 0) {\n    return {\n      valid: true,\n      validationError: null,\n      normalized: {\n        timestamp: typeof body.timestamp === \"string\" && body.timestamp ? body.timestamp : $now.toISO(),\n        event: body.event,\n        status: body.status.trim(),\n        mode: typeof body.mode === \"string\" ? body.mode : \"\",\n        session_id: typeof body.sessionId === \"string\" ? body.sessionId : (typeof body.session_id === \"string\" ? body.session_id : \"\"),\n        recipient_domain: typeof body.recipientDomain === \"string\" ? body.recipientDomain : (typeof body.recipient_domain === \"string\" ? body.recipient_domain : \"\"),\n        expires_at: typeof body.expiresAt === \"string\" ? body.expiresAt : (typeof body.expires_at === \"string\" ? body.expires_at : \"\"),\n        removed: typeof body.removed === \"number\" ? body.removed : \"\",\n        examined: typeof body.examined === \"number\" ? body.examined : \"\"\n      }\n    };\n  }\n  const lines = errors.map(function (e) { return \"• \" + e.p + \": \" + e.m + (e.d ? \" - \" + e.d : \"\"); });\n  const details = {};\n  for (let i = 0; i < errors.length; i++) {\n    if (!(errors[i].p in details)) details[errors[i].p] = errors[i].m;\n  }\n  return {\n    valid: false,\n    validationError: \"Validation failed (\" + errors.length + \" issue\" + (errors.length > 1 ? \"s\" : \"\") + \"):\\n\" + lines.join(\"\\n\"),\n    details: details,\n    requiredSchema: REQUIRED_SCHEMA\n  };\n})() }}",
