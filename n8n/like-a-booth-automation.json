        "emailType": "html",
        "message": "=<div style=\"margin:0;padding:32px 16px;background:#f4f2ee;font-family:Arial,Helvetica,sans-serif;color:#101015;\"><div style=\"max-width:560px;margin:0 auto;background:#ffffff;border-radius:16px;overflow:hidden;border:1px solid #dfd9cf;\"><div style=\"background:#101015;padding:32px 24px;text-align:center;\"><h1 style=\"color:#f4f2ee;font-size:28px;margin:0;letter-spacing:-0.5px;\">like a booth.</h1><p style=\"color:#b8b2a6;font-size:11px;letter-spacing:2px;text-transform:uppercase;margin:10px 0 0;\">A little you. A little art.</p></div><div style=\"padding:32px 28px;text-align:center;\"><p style=\"font-size:11px;letter-spacing:1.8px;text-transform:uppercase;color:#6c665d;margin:0 0 10px;\">{{ $(\"Validate Email Payload\").item.json.result.normalized.mode === \"simulation\" ? \"Simulation Take / Private Link\" : \"Private Gallery / 24-Hour Access\" }}</p><h2 style=\"font-size:24px;line-height:1.3;margin:0 0 14px;color:#101015;\">A moment to keep.</h2><p style=\"font-size:15px;color:#524d46;line-height:1.7;margin:0 0 24px;\">Your finished photobooth artwork is ready. Open the private gallery link below to view and download your PNG before it expires.</p><a href=\"{{ $(\"Validate Email Payload\").item.json.result.normalized.gallery_url }}\" style=\"display:inline-block;background:#101015;color:#f4f2ee;padding:14px 26px;border-radius:999px;text-decoration:none;font-size:14px;font-weight:bold;\">Open Private Artwork</a><p style=\"font-size:12px;color:#787166;line-height:1.7;margin:24px 0 0;\">Expires: {{ DateTime.fromISO($(\"Validate Email Payload\").item.json.result.normalized.expires_at).toUTC().toFormat(\"dd LLL yyyy HH:mm 'UTC'\") }}.<br/>Anyone with this link can view it. Save a copy before expiry.</p></div></div></div>",
